{
  "template_id": "product_video",
  "name": "Commercial Product Video",
  "description": "16:9 widescreen promo template for commercial products, features, and brand advertising.",
  "category": "commercial",
  "aspect_ratio": "16:9",
  "video_source": "pexels",
  "video_concat_mode": "semantic",
  "video_transition_mode": "SlideIn",
  "video_clip_duration": 5,
